{
    "name": "ernestdefoe/waymark",
    "description": "Breadcrumbs for Flarum 2: a trail on every page, from Home through tags to the discussion you are reading, matching the one search engines see.",
    "keywords": [
        "flarum",
        "flarum-extension",
        "breadcrumbs",
        "navigation",
        "seo"
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "homepage": "https://github.com/ernestdefoe/waymark",
    "support": {
        "forum": "https://discuss.flarum.org/d/39983-waymark",
        "issues": "https://github.com/ernestdefoe/waymark/issues",
        "source": "https://github.com/ernestdefoe/waymark"
    },
    "authors": [
        {
            "name": "Ernest Defoe",
            "email": "ernestdefoe@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "flarum/core": "^2.0"
    },
    "suggest": {
        "flarum/tags": "Tag pages and discussions get their tag in the trail.",
        "fof/seo": "Waymark keeps the breadcrumbs FoF SEO gives search engines in step with the visible trail."
    },
    "autoload": {
        "psr-4": {
            "Ernestdefoe\\Waymark\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ernestdefoe\\Waymark\\Tests\\": "tests/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Waymark",
            "category": "feature",
            "icon": {
                "name": "fas fa-signs-post",
                "backgroundColor": "#0f766e",
                "color": "#fff"
            }
        }
    },
    "require-dev": {
        "flarum/phpstan": "^2.0",
        "flarum/tags": "^2.0",
        "flarum/testing": "^2.0",
        "fof/seo": "^4.0"
    },
    "scripts": {
        "test": [
            "@test:integration"
        ],
        "test:integration": "phpunit -c tests/phpunit.integration.xml",
        "test:setup": "@php tests/integration/setup.php",
        "analyse:phpstan": "phpstan analyse"
    },
    "scripts-descriptions": {
        "test": "Runs all tests.",
        "test:integration": "Runs all integration tests.",
        "test:setup": "Sets up a database for use with integration tests. Execute this only once.",
        "analyse:phpstan": "Run static analysis"
    },
    "minimum-stability": "beta",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
